# ===========================
# Google Sheets 設定
# ===========================

# スプレッドシートの URL（ブラウザのアドレスバーからコピー）
# gid= がタブを指定するので、開きたいタブを表示した状態でコピーする
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit?gid=YOUR_GID

# シートタブ名のフォーマット（当日の日付から自動生成）
# 使えるパターン: YYYY=西暦4桁, YY=下2桁, M=月(ゼロ埋めなし), MM=月(ゼロ埋め),
#                D=日(ゼロ埋めなし), DD=日(ゼロ埋め)
# 例: YYYY-MM-DD → "2026-02-24" / M/D → "2/24" / M月D日 → "2月24日"
# 空欄にすると SPREADSHEET_URL の gid で固定タブになる
SHEET_DATE_FORMAT=YYYY-MM-DD

# データ開始行（ヘッダー行をスキップ。デフォルト: 2）
START_ROW=2

# ===========================
# 列設定（A, B, C... または AA, AB... で指定）
# ===========================

# 判別対象の列A（ステータス確認列）
CHECK_COLUMN_A=AG

# 除外条件の列B（この列の値が TRIGGER_STATUS_B_EXCLUDE と一致する行はスキップ）
CHECK_COLUMN_B=AH

# 管理画面URLが入っている列
URL_COLUMN=C

# 処理後に更新する列
UPDATE_COLUMN=AG

# ===========================
# ステータス値設定
# ===========================

# 処理対象とするA列の値（カンマ区切りで複数指定可）
TRIGGER_STATUS_A_LIST=戻し,解体車

# スキップするB列の値（この値の行は処理しない）
TRIGGER_STATUS_B_EXCLUDE=ユーザーキャンセル

# 処理完了後に UPDATE_COLUMN に書き込む値
COMPLETED_STATUS=処理済み

# ===========================
# 管理画面ドロップダウン マッピング
# ===========================

# AG列の値 → 管理画面ドロップダウンで選択する value の対応表（JSON形式）
# 例: AG列が "戻し" の行 → ドロップダウンで "戻し（都度）" を選択
#     AG列が "解体車" の行 → ドロップダウンで "解体（都度戻し）" を選択
ADMIN_VALUE_MAP={"戻し":"戻し（都度）","解体車":"解体（都度戻し）"}

# ===========================
# 管理画面（Playwright）設定
# ===========================

# ステータスドロップダウンのCSSセレクター
ADMIN_DROPDOWN_SELECTOR=select[name="status"]

# 保存ボタンのCSSセレクター
ADMIN_SAVE_SELECTOR=button[type="submit"]

# 保存後の完了確認セレクター（成功メッセージなど。省略可）
ADMIN_SUCCESS_SELECTOR=.bg-blue-50

# ページ読み込み待機時間（ミリ秒）
PAGE_LOAD_TIMEOUT=10000

# ===========================
# 認証設定
# ===========================

# ブラウザの認証状態保存パス（setup-auth.ts で生成）
AUTH_STORAGE_PATH=./auth/state.json

# ===========================
# 動作設定
# ===========================

# ヘッドレスモード（true: バックグラウンド実行 / false: ブラウザ表示）
HEADLESS=false

# 処理間のウェイト時間（ミリ秒）
DELAY_BETWEEN_ROWS=2000

# 処理件数の上限（動作確認時などに使用。0 または未設定で無制限）
# MAX_ROWS=1
