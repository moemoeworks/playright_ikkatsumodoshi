# ===========================
# Google Sheets 設定
# ===========================

# スプレッドシートID（URLの /d/XXXXX/edit の XXXXX 部分）
SPREADSHEET_ID=your_spreadsheet_id_here

# シート名（デフォルト: Sheet1）
SHEET_NAME=Sheet1

# サービスアカウントキーのJSONファイルパス
SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# データ開始行（ヘッダー行をスキップ。デフォルト: 2）
START_ROW=2

# ===========================
# 列設定（A, B, C... で指定）
# ===========================

# 判別対象の列A（ステータス確認列）
CHECK_COLUMN_A=A

# 判別対象の列B（追加条件列。空欄の場合は条件なし）
CHECK_COLUMN_B=B

# 管理画面URLが入っている列
URL_COLUMN=C

# 処理後に更新する列
UPDATE_COLUMN=A

# ===========================
# ステータス値設定
# ===========================

# 処理対象とするA列の値（例: 未処理）
TRIGGER_STATUS_A=未処理

# 処理対象とするB列の値（空欄の場合はB列チェックなし）
TRIGGER_STATUS_B=

# 処理完了後にA列に書き込む値（例: 処理済み）
COMPLETED_STATUS=処理済み

# ===========================
# 管理画面（Playwright）設定
# ===========================

# ステータスドロップダウンのCSSセレクター
ADMIN_DROPDOWN_SELECTOR=select[name="status"]

# ドロップダウンで選択する値（value属性の値）
ADMIN_DROPDOWN_VALUE=approved

# 保存ボタンのCSSセレクター
ADMIN_SAVE_SELECTOR=button[type="submit"]

# 保存後の完了確認セレクター（成功メッセージなど。省略可）
ADMIN_SUCCESS_SELECTOR=

# ページ読み込み待機時間（ミリ秒）
PAGE_LOAD_TIMEOUT=10000

# ===========================
# 認証設定
# ===========================

# ブラウザの認証状態保存パス（setup-auth.ts で生成）
AUTH_STORAGE_PATH=./auth/state.json

# ===========================
# 動作設定
# ===========================

# ヘッドレスモード（true: バックグラウンド実行 / false: ブラウザ表示）
HEADLESS=false

# 処理間のウェイト時間（ミリ秒）
DELAY_BETWEEN_ROWS=2000
